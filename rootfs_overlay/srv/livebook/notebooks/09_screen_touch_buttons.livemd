# 09 — Screen, touch and buttons

## The screen

The display is a Linux framebuffer, `/dev/fb0`. Read its size and format:

```elixir
fb = "/sys/class/graphics/fb0"
read = fn file -> Path.join(fb, file) |> File.read!() |> String.trim() end

[width, height] = read.("virtual_size") |> String.split(",") |> Enum.map(&String.to_integer/1)
bpp = String.to_integer(read.("bits_per_pixel"))
stride = String.to_integer(read.("stride"))
%{width: width, height: height, bits_per_pixel: bpp, stride: stride}
```

The IEx console is also drawn on the screen. Detach it while you draw,
and wake the screen up:

```elixir
fbcon =
  Path.wildcard("/sys/class/vtconsole/vtcon*")
  |> Enum.find(&(File.read!(Path.join(&1, "name")) =~ "frame buffer"))

File.write!(Path.join(fbcon, "bind"), "0")
File.write!(Path.join(fb, "blank"), "0")
```

Helpers to paint pixels. Each pixel is 4 bytes, blue-green-red-unused:

```elixir
defmodule Screen do
  def pixel({r, g, b}), do: <<b, g, r, 0>>

  # Fill a w×h rectangle at (x, y) with one colour.
  def rect(stride, {x, y, w, h}, color) do
    row = :binary.copy(pixel(color), w)
    {:ok, dev} = :file.open("/dev/fb0", [:write, :read, :binary, :raw])

    for line <- y..(y + h - 1) do
      :ok = :file.pwrite(dev, line * stride + x * 4, row)
    end

    :file.close(dev)
  end
end

Screen.rect(stride, {0, 0, width, height}, {0, 0, 80})
```

Colour bands across the screen:

```elixir
colors = [{220, 50, 50}, {240, 200, 40}, {60, 180, 75}, {40, 120, 220}]
band = div(height, length(colors))

for {color, i} <- Enum.with_index(colors) do
  Screen.rect(stride, {0, i * band, width, band}, color)
end

:ok
```

## Touch and buttons

Every touch and button press is a Linux input event. `InputEvent` lists
the input devices:

```elixir
devices = InputEvent.enumerate()
Enum.map(devices, fn {path, info} -> {path, info.name} end)
```

Listen to all of them for 30 seconds. Touch the screen to draw white
squares, and press the volume and power buttons.

```elixir
Screen.rect(stride, {0, 0, width, height}, {0, 0, 0})
frame = Kino.Frame.new() |> Kino.render()
pids = for {path, _info} <- devices, do: elem(InputEvent.start_link(path), 1)
deadline = System.monotonic_time(:millisecond) + 30_000

Stream.unfold(%{x: nil, y: nil}, fn touch ->
  left = deadline - System.monotonic_time(:millisecond)

  receive do
    {:input_event, _path, events} when is_list(events) ->
      touch =
        Enum.reduce(events, touch, fn
          {:ev_abs, :abs_mt_position_x, x}, t -> %{t | x: x}
          {:ev_abs, :abs_mt_position_y, y}, t -> %{t | y: y}
          {:ev_abs, :abs_mt_tracking_id, -1}, _t -> %{x: nil, y: nil}

          {:ev_key, key, 1}, t when key in [:key_volumeup, :key_volumedown, :key_power] ->
            Kino.Frame.append(frame, Kino.Markdown.new("Button: `#{key}`"))
            t

          _other, t ->
            t
        end)

      if touch.x && touch.y do
        x = min(max(touch.x - 20, 0), width - 40)
        y = min(max(touch.y - 20, 0), height - 40)
        Screen.rect(stride, {x, y, 40, 40}, {255, 255, 255})
      end

      {:ok, touch}

    _other ->
      {:ok, touch}
  after
    max(left, 0) -> nil
  end
end)
|> Stream.run()

Enum.each(pids, &InputEvent.stop/1)
```

## Give the screen back to the console

```elixir
File.write!(Path.join(fbcon, "bind"), "1")
```
